<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TSD.Desktop"
             xmlns:conv="using:TSD.Desktop.Converters"
             x:Class="TSD.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Assets/TsdTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusColorConverter x:Key="StatusColorConverter"/>
            <conv:BoolToOrderBgConverter x:Key="BoolToOrderBgConverter"/>
            <conv:BoolToOrderFgConverter x:Key="BoolToOrderFgConverter"/>
            <conv:BoolToOrderLabelConverter x:Key="BoolToOrderLabelConverter"/>
            <conv:RunningBorderConverter x:Key="RunningBorderConverter"/>
            <conv:StatusChipBgConverter x:Key="StatusChipBgConverter"/>
            <conv:StatusChipFgConverter x:Key="StatusChipFgConverter"/>
            <conv:SignalBgConverter x:Key="SignalBgConverter"/>
            <conv:SignalFgConverter x:Key="SignalFgConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Assets/TsdStyles.axaml"/>
    </Application.Styles>
</Application>
