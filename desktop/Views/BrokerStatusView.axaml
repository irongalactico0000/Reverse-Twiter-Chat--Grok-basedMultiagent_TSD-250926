<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TSD.Desktop.ViewModels"
             x:Class="TSD.Desktop.Views.BrokerStatusView"
             x:DataType="vm:BrokerStatusViewModel">

  <Border Classes="Panel">
    <StackPanel Spacing="10">
      <TextBlock Classes="SectionTitle" Text="Broker Connections"/>

      <!-- Error banner -->
      <Border Background="#1E293B" CornerRadius="4" Padding="10,6"
              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FDE68A" FontSize="12"/>
      </Border>

      <!-- Header row -->
      <Grid ColumnDefinitions="2*,3*,*,*" Margin="0,0,0,4">
        <TextBlock Grid.Column="0" Text="Broker" Foreground="#6B7280" FontSize="11" FontWeight="Medium"/>
        <TextBlock Grid.Column="1" Text="Connected" Foreground="#6B7280" FontSize="11" FontWeight="Medium"/>
        <TextBlock Grid.Column="2" Text="Orders?" Foreground="#6B7280" FontSize="11" FontWeight="Medium"/>
        <TextBlock Grid.Column="3" Foreground="#6B7280" FontSize="11"/>
      </Grid>

      <ItemsControl ItemsSource="{Binding Brokers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BrokerRowViewModel">
            <Grid ColumnDefinitions="2*,3*,*,*" Margin="0,4,0,0">

              <!-- Name + PAPER chip -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Name}" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center"/>
                <Border Background="#1E3A5F" CornerRadius="3" Padding="4,1"
                        IsVisible="{Binding IsPaper}">
                  <TextBlock Text="PAPER" Foreground="#60A5FA" FontSize="10" FontWeight="Bold"/>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8"
                         Fill="{Binding Status, Converter={StaticResource StatusColorConverter}}"/>
                <TextBlock Text="{Binding StatusDetail}" Foreground="#D1D5DB" FontSize="12"
                           TextTrimming="CharacterEllipsis" MaxWidth="240"/>
              </StackPanel>

              <!-- Orders badge -->
              <Border Grid.Column="2" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left"
                      Background="{Binding SupportsOrders, Converter={StaticResource BoolToOrderBgConverter}}">
                <TextBlock FontSize="11" FontWeight="SemiBold"
                           Text="{Binding SupportsOrders, Converter={StaticResource BoolToOrderLabelConverter}}"
                           Foreground="{Binding SupportsOrders, Converter={StaticResource BoolToOrderFgConverter}}"/>
              </Border>

              <!-- Connect / Disconnect button -->
              <Panel Grid.Column="3">
                <Button Classes="Primary" Content="Connect"
                        Command="{Binding $parent[UserControl].DataContext.ConnectCommand}"
                        CommandParameter="{Binding Id}"
                        IsVisible="{Binding !IsConnected}"
                        IsEnabled="{Binding !IsConnecting}"/>
                <Button Classes="Ghost" Content="Disconnect"
                        Command="{Binding $parent[UserControl].DataContext.DisconnectCommand}"
                        CommandParameter="{Binding Id}"
                        IsVisible="{Binding IsConnected}"/>
              </Panel>

            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </Border>

</UserControl>
