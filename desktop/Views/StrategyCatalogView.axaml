<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TSD.Desktop.ViewModels"
             x:Class="TSD.Desktop.Views.StrategyCatalogView"
             x:DataType="vm:StrategyCatalogViewModel">

  <Border Classes="Panel">
    <StackPanel Spacing="10">
      <TextBlock Classes="SectionTitle" Text="Strategy Catalog"/>

      <ItemsControl ItemsSource="{Binding Strategies}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StrategyCardViewModel">
            <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                    BorderThickness="1"
                    BorderBrush="{Binding IsRunning, Converter={StaticResource RunningBorderConverter}}">
              <StackPanel Spacing="6">

                <!-- Name + status chip -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#F3F4F6"
                             FontWeight="SemiBold" FontSize="13"/>
                  <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                          Background="{Binding Status, Converter={StaticResource StatusChipBgConverter}}">
                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold"
                               LetterSpacing="0.6"
                               Foreground="{Binding Status, Converter={StaticResource StatusChipFgConverter}}"/>
                  </Border>
                </Grid>

                <!-- Description -->
                <TextBlock Text="{Binding Description}" Foreground="#6B7280" FontSize="11"
                           TextWrapping="Wrap"/>
                <TextBlock Foreground="#6B7280" FontSize="11">
                  <Run Text="{Binding Symbol}"/>
                  <Run Text=" · "/>
                  <Run Text="{Binding Broker}"/>
                </TextBlock>

                <!-- Signal + P&L -->
                <Grid ColumnDefinitions="*,*">
                  <Border Grid.Column="0" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left"
                          Background="{Binding Signal, Converter={StaticResource SignalBgConverter}}">
                    <TextBlock Text="{Binding Signal}" FontSize="11" FontWeight="Bold"
                               Foreground="{Binding Signal, Converter={StaticResource SignalFgConverter}}"/>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Pnl, StringFormat=\${0:+0.00;-0.00}}"
                             FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                             Foreground="#86EFAC"/>
                </Grid>

                <!-- Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,4,0,0">
                  <Button Grid.Column="0" Classes="Ghost" Content="{Binding ToggleLabel}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding CanToggle}"
                          Command="{Binding $parent[UserControl].DataContext.ToggleCommand}"
                          CommandParameter="{Binding}"/>
                  <Button Grid.Column="1" Classes="Ghost" Content="Stop"
                          Foreground="#F87171" HorizontalAlignment="Stretch"
                          Command="{Binding $parent[UserControl].DataContext.StopCommand}"
                          CommandParameter="{Binding}"/>
                </Grid>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </Border>

</UserControl>
