GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=PASTE_YOUR_ACTUAL_API_KEY_HERE

# === HTTP hardening ===
# Comma-separated origins. Use * only for local demos (disables credentials).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# === Trading prototype gates (fail-closed) ===
# Mutations stay off unless both flags/token are set deliberately.
TRADING_MUTATIONS_ENABLED=false
TRADING_REQUIRE_AUTH_FOR_READS=true
TRADING_API_TOKEN=replace_with_long_random_token

# === Paper target bridge (SQLite) ===
# TSD_BRIDGE_DB=C:\path\to\bridge.sqlite
TSD_MAX_ORDER_QTY=10
TSD_MAX_ABS_POSITION=100
TSD_MAX_MD_AGE_MS=5000
TSD_KILL_SWITCH=false

# === Alpaca (paper by default) ===
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true

# === Interactive Brokers ===
# Requires TWS or IB Gateway running locally
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
IB_PAPER=true

# === cTrader ===
CTRADER_CLIENT_ID=your_ctrader_client_id
CTRADER_CLIENT_SECRET=your_ctrader_client_secret
CTRADER_ACCESS_TOKEN=your_ctrader_access_token
CTRADER_ACCOUNT_ID=your_ctrader_account_id
CTRADER_DEMO=true